import machine
import time

led = machine.Pin(14, machine.Pin.OUT)
botao = machine.Pin(33, machine.Pin.IN, machine.Pin.PULL_UP)
led2 = machine.Pin(13, machine.Pin.OUT)
botao2 = machine.Pin(34, machine.Pin.IN, machine.Pin.PULL_UP)
led3 = machine.Pin(12, machine.Pin.OUT)
botao3 = machine.Pin(35, machine.Pin.IN, machine.Pin.PULL_UP)


while (True):

    estado = botao.value()
    estado2 = botao2.value()
    estado3 = botao3.value()


    if (estado == 0):
        print("botão pressionado!! KKKKKKKKKK")
        led.on()
        time.sleep(3.0)
        led.off()
        led2.on()
        time.sleep(5)
        led2.off()
        led3.on()
        time.sleep(1)
        led3.off()

    if (estado2 == 0):
        led.on()
        time.sleep(0.5)
        led.off()
